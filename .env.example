# Database Configuration
DB_HOST=db
DB_NAME=router
DB_USER=router
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secretroot

# NetFlow Collector Configuration (nfacctd)
NFACCTD_PORT=2055
LOCAL_SUBNET=192.168.1.0/24
LOCAL_SUBNET_V6=fd00::/8

# Optional Custom BPF Filters (Leave blank to use automatic LOCAL_SUBNET filters)
# NFACCTD_FILTER_IN=(dst net 192.168.1.0/24 or dst net fd00::/8) and not (src net 192.168.1.0/24 or src net fd00::/8)
# NFACCTD_FILTER_OUT=(src net 192.168.1.0/24 or src net fd00::/8) and not (dst net 192.168.1.0/24 or dst net fd00::/8)

# Web Application Configuration
WEB_PORT=80
