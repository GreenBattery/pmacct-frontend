! nfacctd configuration template
daemonize: false
debug: false
pidfile: /var/run/nfacctd.pid

! Log timestamps format
log_timestamps: true
log_timestamps_format: %Y-%m-%d %H:%M:%S

! Print periodic flow and packet statistics to container stdout every 60 seconds
nfacctd_st_time: 30


! Add print[debug] to your existing plugins line
plugins: mysql[in], mysql[out], print[debug]

! --- Debug Plugin Configuration ---
! Use the same aggregation primitives so you see the same fields
aggregate[debug]: src_host, dst_host, proto, src_port, dst_port, tag

! Filter for just your local IP so the logs aren't overwhelmed,
! but do NOT specify 'src' or 'dst' so we catch it regardless of direction.
aggregate_filter[debug]: host 192.168.1.148

! Output format settings
print_output[debug]: formatted
print_refresh_time[debug]: 10

! interested in in and outbound traffic
aggregate[in]: src_host, dst_host, proto, tag, src_mac, dst_mac, vlan, src_port, dst_port
aggregate_filter[in]: ${NFACCTD_FILTER_IN}

aggregate[out]: src_host, dst_host, proto, tag, src_mac, dst_mac, vlan, src_port, dst_port
aggregate_filter[out]: ${NFACCTD_FILTER_OUT}

! plugins: mysql[in], mysql[out]

sql_user: ${DB_USER}
sql_passwd: ${DB_PASSWORD}
sql_db: ${DB_NAME}
sql_host: ${DB_HOST}

sql_optimize_clauses: true

nfacctd_port: ${NFACCTD_PORT}
sql_refresh_time: 60
sql_history: 5m
sql_history_roundoff: mh
sql_table_version: 2

sql_table[in]: inbound_%m%Y
sql_table[out]: outbound_%m%Y
sql_table_schema[in]: /etc/pmacct/inbound.sql
sql_table_schema[out]: /etc/pmacct/outbound.sql
